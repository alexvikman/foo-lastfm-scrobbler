* text=auto

# Source and documentation
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows and Visual Studio files
*.ps1 text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.rc text eol=crlf

# Binary artifacts
*.7z binary
*.dll binary
*.exe binary
*.fb2k-component binary
*.lib binary
*.pdb binary
*.png binary
